# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.

# ─── WalletConnect ────────────────────────────────────────────────────────────
# MUST have NEXT_PUBLIC_ prefix — this value is baked into the client-side JS
# bundle at build time (read by lib/wagmi.ts via getDefaultConfig).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ─── Claim Issuer private key (server-side only) ─────────────────────────────
ISSUER_PRIVATE_KEY=your_claim_issuer_private_key

# ─── RPC endpoints ────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ─── Block Explorer API Keys (server-side only, used for Transaction History) ─
# Etherscan (Ethereum Mainnet + Sepolia): https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key
# BscScan (BSC Mainnet + Testnet): https://bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key

# ─── PostgreSQL (Prisma) ───────────────────────────────────────────────────────
# Start the local database with:  docker compose up -d  (from the repo root)
# Credentials must match docker-compose.yml:
DATABASE_URL="postgresql://postgres:trex_dev_pass@localhost:5432/trex_dashboard?schema=public"
#
# ⚠️  Vercel note: add DATABASE_URL to BOTH "Build" and "Runtime" environment
#     variable scopes in the Vercel dashboard.  The postinstall hook runs
#     `prisma generate` during the build step and requires DATABASE_URL to be
#     present even though it does not open a real DB connection at that point.
#
# ⚠️  NODE_TLS_REJECT_UNAUTHORIZED must NOT be set (or must be set to "1") in
#     any production / Vercel environment.  Setting it to "0" disables TLS
#     certificate verification in the /api/rpc proxy and is a security risk.