{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": "nextjs",

  "buildCommand": "npm run build:vercel",

  "installCommand": "npm ci",

  "outputDirectory": ".next",

  "regions": ["sin1"],

  "env": {
    "NEXT_OUTPUT_MODE": ""
  },

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ]
}
