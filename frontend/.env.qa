# ─── QA Environment ───────────────────────────────────────────────────────────
WALLETCONNECT_PROJECT_ID=your_qa_walletconnect_project_id

# ─── RPC endpoints (server-side only) ──────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://cloudflare-eth.com
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ─── Default network shown in the UI ─────────────────────────────────────────
NEXT_PUBLIC_NETWORK=sepolia

# ─── Claim Issuer (server-side only — never expose to browser) ────────────────
# Private key of the wallet registered as a signing key on the ClaimIssuer
# contract. Used ONLY in /api/sign-claim. Leave blank here and inject via
# your secrets manager (ECS Secrets, K8s Secret, SSM Parameter Store, etc.)
ISSUER_PRIVATE_KEY=