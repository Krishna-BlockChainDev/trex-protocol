# ─── Production Environment ───────────────────────────────────────────────────
# MUST have NEXT_PUBLIC_ prefix — baked into the client JS bundle at build time.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_prod_walletconnect_project_id

# ─── RPC endpoints (server-side only) ──────────
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_key
MAINNET_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ─── Default network shown in the UI ─────────────────────────────────────────
NEXT_PUBLIC_NETWORK=mainnet

# ─── PostgreSQL (Prisma) ───────────────────────────────────────────────────────
# ⚠️  Vercel: add DATABASE_URL to BOTH "Build" AND "Runtime" env scopes.
#     postinstall runs `prisma generate` during the build step and needs it.
DATABASE_URL=

# ─── Claim Issuer (server-side only — never expose to browser) ────────────────
# Private key of the wallet registered as a signing key on the ClaimIssuer
# contract. Used ONLY in /api/sign-claim. Inject via your secrets manager
# (Vercel Env Vars / ECS Secrets / K8s Secret / SSM Parameter Store, etc.)
ISSUER_PRIVATE_KEY=

# ─── Security ─────────────────────────────────────────────────────────────────
# ⚠️  NODE_TLS_REJECT_UNAUTHORIZED must NOT be set (or must equal "1") in prod.
#     Setting it to "0" disables TLS cert verification in /api/rpc — security risk.
# NODE_TLS_REJECT_UNAUTHORIZED=1